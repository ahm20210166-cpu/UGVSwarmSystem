import cv2, numpy as np, os, time

W, H = 1280, 720
CHESSBOARD = (9, 6)      # inner corners (columns, rows)
SQUARE_CM = 2.5          
OUT_FILE = "/home/malekehab/ugv/cam_calib_1280x720.npz"

criteria = (cv2.TERM_CRITERIA_EPS + cv2.TERM_CRITERIA_MAX_ITER, 30, 0.001)

objp = np.zeros((CHESSBOARD[0]*CHESSBOARD[1],3), np.float32)
objp[:,:2] = np.mgrid[0:CHESSBOARD[0],0:CHESSBOARD[1]].T.reshape(-1,2)
objp *= SQUARE_CM

objpoints, imgpoints = [], []

cap = cv2.VideoCapture(0, cv2.CAP_V4L2)
cap.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc(*'MJPG'))
cap.set(cv2.CAP_PROP_FRAME_WIDTH, W)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, H)
cap.set(cv2.CAP_PROP_FPS, 30)

print("Chessboard calibration:")
print("- Show the chessboard clearly.")
print("- Press 's' to SAVE a sample when corners are detected.")
print("- Collect 15–25 samples (different angles/distances).")
print("- Press 'c' to CALIBRATE and SAVE.")
print("- Press 'q' to quit.\n")

while True:
    ok, frame = cap.read()
    if not ok:
        continue
    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)

    ret, corners = cv2.findChessboardCorners(gray, CHESSBOARD, None)
    disp = frame.copy()

    if ret:
        corners2 = cv2.cornerSubPix(gray, corners, (11,11), (-1,-1), criteria)
        cv2.drawChessboardCorners(disp, CHESSBOARD, corners2, ret)
        cv2.putText(disp, "Corners found (press s)", (20,40), cv2.FONT_HERSHEY_SIMPLEX, 1.0, (0,255,0), 2)
    else:
        cv2.putText(disp, "No corners", (20,40), cv2.FONT_HERSHEY_SIMPLEX, 1.0, (0,0,255), 2)

    cv2.putText(disp, f"samples: {len(objpoints)}", (20,80), cv2.FONT_HERSHEY_SIMPLEX, 1.0, (255,255,255), 2)
    cv2.imshow("Calibration", disp)

    k = cv2.waitKey(1) & 0xFF
    if k == ord('q'):
        break

    if k == ord('s') and ret:
        objpoints.append(objp)
        imgpoints.append(corners2)
        print("Saved sample", len(objpoints))
        time.sleep(0.2)

    if k == ord('c'):
        if len(objpoints) < 10:
            print("Need at least 10 samples before calibrating.")
            continue
        ok2, mtx, dist, rvecs, tvecs = cv2.calibrateCamera(objpoints, imgpoints, gray.shape[::-1], None, None)
        os.makedirs(os.path.dirname(OUT_FILE), exist_ok=True)
        np.savez(OUT_FILE, mtx=mtx, dist=dist, w=W, h=H, chessboard=CHESSBOARD, square_cm=SQUARE_CM)
        print("Saved calibration to:", OUT_FILE)
        print("Done.")
        break

cap.release()
cv2.destroyAllWindows()
