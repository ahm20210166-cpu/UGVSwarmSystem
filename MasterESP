void doHorizontal() {

  if(formation == 1){

    moveMotorTurnsBack(LEFT_MOTOR, 1.96);
    moveMotorTurnsBack(RIGHT_MOTOR, 1.96);

    waitForMotors(1.96, true, true);

    formation = 0;
  }

  formation = 0;
}
