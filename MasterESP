#include <WiFi.h>
#include <esp_now.h>

#define MOTORS 2
#define PULSES_PER_REV 380

// ===== ULTRASONIC =====
#define TRIG_PIN 13
#define ECHO_PIN 34
#define OBSTACLE_DISTANCE 20

// ===== ENCODERS =====
int ENCODER_A[MOTORS] = {27, 33};
int ENCODER_B[MOTORS] = {32, 14};

// ===== MOTORS =====
int MOTOR_DIR_PIN1[MOTORS] = {18, 19};
int MOTOR_DIR_PIN2[MOTORS] = {23, 5};
int MOTOR_PWM_PIN[MOTORS]  = {25, 26};

// ===== SETTINGS =====
int motorSpeed = 200;

#define LEFT_MOTOR  0
#define RIGHT_MOTOR 1

int formation = 0;
//0=default
//1=triangle

volatile long encoderCount[MOTORS] = {0, 0};

// ===== ESP-NOW =====
uint8_t controllerAddress[] = {0x5C, 0x01, 0x3B, 0x98, 0xAD, 0xB8};
uint8_t slaveAddress1[]     = {0x94, 0x54, 0xC5, 0x76, 0x3C, 0x0C};
uint8_t slaveAddress2[]     = {0xEC, 0xE3, 0x34, 0x19, 0x0D, 0x34};
uint8_t HelperAddress[]     = {0xD0, 0xEF, 0x76, 0x32, 0xB7, 0xE8};
uint8_t HelperAddress2[]    = {0xF0, 0x24, 0xF9, 0x57, 0x66, 0x50};

typedef struct {
  char command[20];
} Message;

Message msg;

// ===== COMMAND QUEUE =====
volatile bool commandPending = false;
char pendingCommand[20] = "";

// ======================================
// ULTRASONIC
// ======================================

float getDistance() {

  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);

  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);

  digitalWrite(TRIG_PIN, LOW);

  long duration = pulseIn(ECHO_PIN,
                          HIGH,
                          30000);

  if (duration == 0) return 999;

  return duration * 0.034 / 2.0;
}

bool checkObstacle() {

  float distance = getDistance();

  return (distance > 0 &&
          distance < OBSTACLE_DISTANCE);
}

// ======================================
// RECEIVE FROM CONTROLLER
// ======================================

void onReceive(const esp_now_recv_info *info,
               const uint8_t *data,
               int len) {

  Message* received = (Message*)data;

  strcpy(msg.command, received->command);

  esp_now_send(slaveAddress1,
               (uint8_t*)&msg,
               sizeof(msg));

  esp_now_send(slaveAddress2,
               (uint8_t*)&msg,
               sizeof(msg));

  Serial.print("Forwarded: ");
  Serial.println(received->command);

  strncpy(pendingCommand,
          received->command,
          sizeof(pendingCommand));

  commandPending = true;
}

// ===== SEND CALLBACK =====

void onSent(const uint8_t *mac,
            esp_now_send_status_t status) {

  Serial.println(status == ESP_NOW_SEND_SUCCESS
                 ? "OK"
                 : "FAIL");
}

// ===== ADD PEER =====

void addPeer(uint8_t* address) {

  esp_now_peer_info_t peerInfo = {};

  memcpy(peerInfo.peer_addr, address, 6);

  peerInfo.channel = 0;
  peerInfo.encrypt = false;

  esp_now_add_peer(&peerInfo);
}

// ======================================
// SETUP
// ======================================

void setup() {

  Serial.begin(115200);

  delay(500);

  // ===== MOTOR SETUP =====
  for (int i = 0; i < MOTORS; i++) {

    pinMode(MOTOR_DIR_PIN1[i], OUTPUT);
    pinMode(MOTOR_DIR_PIN2[i], OUTPUT);
    pinMode(MOTOR_PWM_PIN[i], OUTPUT);

    stopMotor(i);
  }

  // ===== ENCODERS =====
  pinMode(ENCODER_A[LEFT_MOTOR], INPUT_PULLUP);
  pinMode(ENCODER_A[RIGHT_MOTOR], INPUT_PULLUP);

  attachInterrupt(
    digitalPinToInterrupt(ENCODER_A[LEFT_MOTOR]),
    []() { encoderCount[LEFT_MOTOR]++; },
    RISING
  );

  attachInterrupt(
    digitalPinToInterrupt(ENCODER_A[RIGHT_MOTOR]),
    []() { encoderCount[RIGHT_MOTOR]++; },
    RISING
  );

  // ===== ULTRASONIC =====
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);

  // ===== ESP-NOW =====
  WiFi.mode(WIFI_STA);

  Serial.print("Master MAC: ");
  Serial.println(WiFi.macAddress());

  if (esp_now_init() != ESP_OK) {

    Serial.println("ESP-NOW init FAILED");
    return;
  }

  esp_now_register_send_cb(onSent);
  esp_now_register_recv_cb(onReceive);

  addPeer(controllerAddress);
  addPeer(slaveAddress1);
  addPeer(slaveAddress2);
  addPeer(HelperAddress);
  addPeer(HelperAddress2);

  Serial.println("Master ready");
}

// ======================================
// LOOP
// ======================================

void loop() {

  if (commandPending) {

    commandPending = false;

    char cmd[20];

    strncpy(cmd, pendingCommand, sizeof(cmd));

    Serial.print("Executing: ");
    Serial.println(cmd);

    if      (strcmp(cmd, "FORWARD") == 0) moveForward();
    else if (strcmp(cmd, "BACK")    == 0) moveBack();
    else if (strcmp(cmd, "LEFT")    == 0) moveLeft();
    else if (strcmp(cmd, "RIGHT")   == 0) moveRight();

    else if (strcmp(cmd, "Triangle") == 0) {
      doTriangle();
    }

    else if (strcmp(cmd, "Square") == 0) doSquare();
    else if (strcmp(cmd, "V")      == 0) doV();
    else if (strcmp(cmd, "T")      == 0) doT();
    else if (strcmp(cmd, "Line")   == 0) doLine();

    else if (strcmp(cmd, "Horizontal") == 0) {
      doHorizontal();
    }

    else if(strcmp(cmd,"CORRECT_FORMATION") == 0){

      esp_now_send(HelperAddress,
                   (uint8_t *)"CORRECT",
                   strlen("CORRECT")+1);

      delay(3000);

      esp_now_send(HelperAddress2,
                   (uint8_t *)"CORRECT",
                   strlen("CORRECT")+1);
    }
  }
}

// ======================================
// MOTOR FUNCTIONS
// ======================================

void moveMotorTurns(int motor, float turns) {

  noInterrupts();
  encoderCount[motor] = 0;
  interrupts();

  digitalWrite(MOTOR_DIR_PIN1[motor], HIGH);
  digitalWrite(MOTOR_DIR_PIN2[motor], LOW);

  analogWrite(MOTOR_PWM_PIN[motor],
              motorSpeed);
}

void moveMotorTurnsBack(int motor, float turns) {

  noInterrupts();
  encoderCount[motor] = 0;
  interrupts();

  digitalWrite(MOTOR_DIR_PIN1[motor], LOW);
  digitalWrite(MOTOR_DIR_PIN2[motor], HIGH);

  analogWrite(MOTOR_PWM_PIN[motor],
              motorSpeed);
}

void waitForMotors(float turns,
                   bool waitLeft,
                   bool waitRight) {

  long targetPulses =
      (long)(turns * PULSES_PER_REV);

  bool leftDone  = !waitLeft;
  bool rightDone = !waitRight;

  while (true) {

    // ===== OBSTACLE =====
    if (checkObstacle()) {

      stopAll();

      return;
    }

    noInterrupts();

    long leftCount  = encoderCount[LEFT_MOTOR];
    long rightCount = encoderCount[RIGHT_MOTOR];

    interrupts();

    if (waitLeft &&
        !leftDone &&
        leftCount >= targetPulses) {

      stopMotor(LEFT_MOTOR);
      leftDone = true;
    }

    if (waitRight &&
        !rightDone &&
        rightCount >= targetPulses) {

      stopMotor(RIGHT_MOTOR);
      rightDone = true;
    }

    if (leftDone && rightDone) {
      break;
    }

    delay(10);
  }
}

void stopMotor(int motor) {

  digitalWrite(MOTOR_DIR_PIN1[motor], LOW);
  digitalWrite(MOTOR_DIR_PIN2[motor], LOW);

  analogWrite(MOTOR_PWM_PIN[motor], 0);
}

void stopAll() {

  stopMotor(LEFT_MOTOR);
  stopMotor(RIGHT_MOTOR);
}

// ======================================
// MOVEMENTS
// ======================================

void moveForward() {

  moveMotorTurns(LEFT_MOTOR, 1);
  moveMotorTurns(RIGHT_MOTOR, 1);

  waitForMotors(1, true, true);
}

void moveBack() {

  moveMotorTurnsBack(LEFT_MOTOR, 1);
  moveMotorTurnsBack(RIGHT_MOTOR, 1);

  waitForMotors(1, true, true);
}

void moveLeft() {

  if(formation == 0){

    moveMotorTurns(LEFT_MOTOR, 1.65);
    moveMotorTurns(RIGHT_MOTOR, 1.65);

    waitForMotors(1.65, true, true);

    delay(300);

    moveMotorTurnsBack(LEFT_MOTOR, 1.25);
    moveMotorTurns(RIGHT_MOTOR, 1.25);

    waitForMotors(1.25, true, true);

    delay(300);

    moveMotorTurns(LEFT_MOTOR, 1.13);
    moveMotorTurns(RIGHT_MOTOR, 1.13);

    waitForMotors(1.13, true, true);
  }

  else if(formation == 1){

    moveMotorTurnsBack(LEFT_MOTOR, 1.25);
    moveMotorTurns(RIGHT_MOTOR, 1.25);

    waitForMotors(1.25, true, true);

    delay(300);

    moveMotorTurns(LEFT_MOTOR, 1.13);
    moveMotorTurns(RIGHT_MOTOR, 1.13);

    waitForMotors(1.13, true, true);

    delay(300);

    moveMotorTurnsBack(LEFT_MOTOR, 1.25);
    moveMotorTurns(RIGHT_MOTOR, 1.25);

    waitForMotors(1.25, true, true);

    delay(300);

    moveMotorTurns(LEFT_MOTOR, 0.984);
    moveMotorTurns(RIGHT_MOTOR, 0.984);

    waitForMotors(0.984, true, true);

    moveMotorTurns(LEFT_MOTOR, 1.25);
    moveMotorTurnsBack(RIGHT_MOTOR, 1.25);

    waitForMotors(1.25, true, true);
  }
}

void moveRight() {

  if(formation == 0){

    moveMotorTurns(LEFT_MOTOR, 1.65);
    moveMotorTurns(RIGHT_MOTOR, 1.65);

    waitForMotors(1.65, true, true);

    delay(300);

    moveMotorTurns(LEFT_MOTOR, 1.25);
    moveMotorTurnsBack(RIGHT_MOTOR, 1.25);

    waitForMotors(1.25, true, true);

    delay(300);

    moveMotorTurns(LEFT_MOTOR, 1.13);
    moveMotorTurns(RIGHT_MOTOR, 1.13);

    waitForMotors(1.13, true, true);
  }

  else if(formation == 1){

    moveMotorTurns(LEFT_MOTOR, 1.25);
    moveMotorTurnsBack(RIGHT_MOTOR, 1.25);

    waitForMotors(1.25, true, true);

    delay(300);

    moveMotorTurns(LEFT_MOTOR, 1.13);
    moveMotorTurns(RIGHT_MOTOR, 1.13);

    waitForMotors(1.13, true, true);

    delay(300);

    moveMotorTurns(LEFT_MOTOR, 1.25);
    moveMotorTurnsBack(RIGHT_MOTOR, 1.25);

    waitForMotors(1.25, true, true);

    delay(300);

    moveMotorTurns(LEFT_MOTOR, 0.984);
    moveMotorTurns(RIGHT_MOTOR, 0.984);

    waitForMotors(0.984, true, true);

    moveMotorTurnsBack(LEFT_MOTOR, 1.25);
    moveMotorTurns(RIGHT_MOTOR, 1.25);

    waitForMotors(1.25, true, true);
  }
}

// ======================================
// FORMATIONS
// ======================================

void doTriangle() {

  if(formation == 0){

    moveMotorTurns(LEFT_MOTOR, 1.96);
    moveMotorTurns(RIGHT_MOTOR, 1.96);

    waitForMotors(1.96, true, true);

    formation = 1;
  }

  formation = 1;
}

