// MOVEMENT COMMANDS
// ======================================

void moveForward() {
  moveMotorTurns(LEFT_MOTOR,  1);
  moveMotorTurns(RIGHT_MOTOR, 1);
  waitForMotors(1, true, true);
}

void moveForwards(float x) {
  moveMotorTurns(LEFT_MOTOR,  x);
  moveMotorTurns(RIGHT_MOTOR, x);
  waitForMotors(x, true, true);
}

void moveBack() {
  moveMotorTurnsBack(LEFT_MOTOR,  1);
  moveMotorTurnsBack(RIGHT_MOTOR, 1);
  waitForMotors(1, true, true);
}

void moveBacks(float x) {
  moveMotorTurnsBack(LEFT_MOTOR,  x);
  moveMotorTurnsBack(RIGHT_MOTOR, x);
  waitForMotors(x, true, true);
}

