// ======================================
// MOTOR FUNCTIONS
// ======================================

void moveMotorTurns(int motor, float turns) {
  noInterrupts();
  encoderCount[motor] = 0;
  interrupts();

  digitalWrite(MOTOR_DIR_PIN1[motor], HIGH);
  digitalWrite(MOTOR_DIR_PIN2[motor], LOW);
  analogWrite(MOTOR_PWM_PIN[motor], motorSpeed);
}

void moveMotorTurnsBack(int motor, float turns) {
  noInterrupts();
  encoderCount[motor] = 0;
  interrupts();

  digitalWrite(MOTOR_DIR_PIN1[motor], LOW);
  digitalWrite(MOTOR_DIR_PIN2[motor], HIGH);
  analogWrite(MOTOR_PWM_PIN[motor], motorSpeed);
}

void waitForMotors(float turns, bool waitLeft, bool waitRight) {
  long targetPulses = (long)(turns * PULSES_PER_REV);

  bool leftDone  = !waitLeft;
  bool rightDone = !waitRight;

  while (true) {
    noInterrupts();
    long leftCount  = encoderCount[LEFT_MOTOR];
    long rightCount = encoderCount[RIGHT_MOTOR];
    interrupts();

    if (waitLeft  && !leftDone  && leftCount  >= targetPulses) {
      stopMotor(LEFT_MOTOR);
      leftDone = true;
    }
    if (waitRight && !rightDone && rightCount >= targetPulses) {
      stopMotor(RIGHT_MOTOR);
      rightDone = true;
    }

    if (leftDone && rightDone) break;
    delay(10);
  }
}

void stopMotor(int motor) {
  digitalWrite(MOTOR_DIR_PIN1[motor], LOW);
  digitalWrite(MOTOR_DIR_PIN2[motor], LOW);
  analogWrite(MOTOR_PWM_PIN[motor], 0);
}

void stopAll() {
  stopMotor(LEFT_MOTOR);
  stopMotor(RIGHT_MOTOR);
}

// ======================================
// MOVEMENT COMMANDS
// ======================================

void moveForward() {
  moveMotorTurns(LEFT_MOTOR,  1);
  moveMotorTurns(RIGHT_MOTOR, 1);
  waitForMotors(1, true, true);
}

void moveBack() {
  moveMotorTurnsBack(LEFT_MOTOR,  1);
  moveMotorTurnsBack(RIGHT_MOTOR, 1);
  waitForMotors(1, true, true);
}

void moveLeft() {
  moveMotorTurns(LEFT_MOTOR,  0.5);
  moveMotorTurnsBack(RIGHT_MOTOR, 0.5);
  waitForMotors(0.5, true, true);
}

void moveRight() {
  moveMotorTurnsBack(LEFT_MOTOR,  0.5);
  moveMotorTurns(RIGHT_MOTOR, 0.5);
  waitForMotors(0.5, true, true);
}


void moveLeft60() {
  moveMotorTurnsBack(LEFT_MOTOR,  0.6667);
  moveMotorTurns(RIGHT_MOTOR, 0.6667);
  waitForMotors(0.6667, true, true);
}

void moveRight60() {
  moveMotorTurns(LEFT_MOTOR,  0.6667);
  moveMotorTurnsBack(RIGHT_MOTOR, 0.6667);
  waitForMotors(0.6667, true, true);
}

// ======================================
// FORMATIONS (fill in your logic)
// ======================================

void doTriangle(){
  moveForward();
  delay(300);
  moveRight60();
  delay(300);
  moveForward();
  delay(300);
  moveRight60();
  delay(300);
  moveForward();
}


void doSquare(){
  moveForward();
  delay(300);
  moveRight();
  delay(300);
  moveForward();
  delay(300);
  moveRight();
  delay(300);
  moveForward();
  delay(300);
  moveRight();
  delay(300);
  moveForward();
}


